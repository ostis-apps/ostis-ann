        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70181424" parent="0" x="798.847" y="1097.23" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Случайные леса уменьшают риск переобучения, так как каждое дерево обучается на случайной подвыборке данных и использует случайный набор признаков, что способствует разнообразию в ансамбле. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70174464" parent="0" x="895.739" y="1279.88" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Random Forests reduce the risk of overfitting by training each tree on a random subset of data and using a random set of features, promoting diversity within the ensemble. ]]></content>
        </node>
