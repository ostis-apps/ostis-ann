        <node type="node/const/perm/general" idtf="" shapeColor="0" id="72289424" parent="0" x="1706.54" y="192.989" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Для решения задач временных рядов часто применяются рекуррентные нейронные сети, которые помогают учитывать временные зависимости и выявлять тренды и сезонные колебания. ]]></content>
        </node>
