        <node type="node/const/perm/general" idtf="" shapeColor="0" id="69930352" parent="0" x="1172.21" y="193.706" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[SVR can effectively handle nonlinear data by employing kernel functions, such as the radial basis function (RBF), making it a powerful tool for complex regression tasks. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="38515232" parent="0" x="1706.54" y="192.989" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[SVR может эффективно работать с нелинейными данными за счет применения ядерных функций, таких как радикальная базисная функция (RBF), что делает его мощным инструментом для сложных задач регрессии. ]]></content>
        </node>
        <node type="node/const/perm/group" idtf="concept_ε-insensitivity" shapeColor="0" id="69993936" parent="0" left="0" top="0" right="157" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1316.79" y="900.167" haveBus="false" idtf_pos="5">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="69930128" parent="0" x="895.739" y="1279.88" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Support Vector Regression focuses on building a model that makes
predictions with minimal error, using the concept of ε-insensitivity, which allows ignoring insignificant errors and focusing on more impactful data. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="Утв. 1 (Преимущеcтво SVM)" shapeColor="0" id="70024832" parent="0" left="0" top="0" right="207" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1318.83" y="1081.56" haveBus="false" idtf_pos="0">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70052192" parent="0" x="805.847" y="1096.23" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Регрессия SVM фокусируется на создании модели, которая делает предсказания с минимальной ошибкой, используя концепцию ε-усеченного подхода, что позволяет игнорировать незначительные ошибки и сосредоточиться на более важных данных. ]]></content>
        </node>
        <node type="node/const/perm/group" idtf="concept_support_vector" shapeColor="0" id="70097984" parent="0" left="0" top="0" right="162" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1335.27" y="612.357" haveBus="false" idtf_pos="5">
