        <node type="node/const/perm/general" idtf="Утв. 2 (работа SVR c нелинейными данными)" shapeColor="0" id="69970464" parent="0" left="0" top="0" right="338" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1330.31" y="489.026" haveBus="false" idtf_pos="3">
