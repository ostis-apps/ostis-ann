        <node type="node/const/perm/group" idtf="concept_L1_regularization" shapeColor="0" id="71127024" parent="0" left="0" top="0" right="187" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1335.27" y="612.357" haveBus="false" idtf_pos="5">
