        <node type="node/const/perm/general" idtf="" shapeColor="0" id="71046352" parent="0" x="456.401" y="185.285" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Lasso Regression is a linear regression method that employs L1 regularization to reduce model complexity and prevent overfitting by adding a penalty for the magnitude of the coefficients. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="71134320" parent="0" x="457.793" y="347.553" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Лассо-регрессия  — это метод линейной регрессии, который использует регуляризацию L1 для уменьшения модели и предотвращения переобучения, добавляя штраф за величину коэффициентов. ]]></content>
        </node>
