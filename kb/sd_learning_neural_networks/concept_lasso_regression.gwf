        <node type="node/const/perm/general" idtf="Утв. 1 (Влияние лассо-регрессии на модель)" shapeColor="0" id="71225888" parent="0" left="0" top="0" right="318" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1318.83" y="1081.56" haveBus="false" idtf_pos="0">
