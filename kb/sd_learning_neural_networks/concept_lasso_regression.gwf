        <node type="node/const/perm/group" idtf="concept_high_dimensional_data" shapeColor="0" id="71046944" parent="0" left="0" top="0" right="224" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1484.17" y="489.269" haveBus="false" idtf_pos="5">
