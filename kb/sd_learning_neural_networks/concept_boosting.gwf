        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70114704" parent="0" x="1026.92" y="902.687" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[boosting]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70181712" parent="0" x="826.766" y="521.502" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[concept_boosting]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70174704" parent="0" x="457.793" y="347.553" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Бустинг — это метод ансамблевого обучения, который комбинирует несколько слабых моделей для создания одной сильной модели, улучшая предсказательную способность за счет последовательного исправления ошибок предыдущих моделей. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70167648" parent="0" x="456.401" y="185.285" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Boosting is an ensemble learning method that combines multiple weak models to create one strong model, improving predictive performance by sequentially correcting the errors of previous models. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="Опр. (бустинг)" shapeColor="0" id="70149056" parent="0" left="0" top="0" right="111" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1333.1" y="719.262" haveBus="false" idtf_pos="0">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
        <node type="node/const/perm/general" idtf="Утв. 1 (Влияние бустинга на модель)" shapeColor="0" id="70129040" parent="0" left="0" top="0" right="273" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1318.83" y="1081.56" haveBus="false" idtf_pos="0">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70122032" parent="0" x="805.847" y="1096.23" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Бустинг эффективен для повышения точности моделей, таких как решающие деревья, за счет адаптивного изменения весов неправильных предсказаний, что позволяет сосредоточиться на более сложных примерах. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="70114976" parent="0" x="895.739" y="1279.88" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Boosting effective for enhancing the accuracy of models like decision trees by adaptively changing the weights of mispredictions, allowing the focus on more challenging examples. ]]></content>
        </node>
        <node type="node/const/perm/group" idtf="concept_decision_tree" shapeColor="0" id="69975040" parent="0" left="0" top="0" right="153" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1361.5" y="949.5" haveBus="false" idtf_pos="5">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
