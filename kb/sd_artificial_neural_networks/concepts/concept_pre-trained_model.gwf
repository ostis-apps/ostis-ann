        <node type="node/const/perm/group" idtf="concept_model_training" shapeColor="0" id="36999216" parent="0" left="0" top="0" right="169" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1316.79" y="901.167" haveBus="false" idtf_pos="5">
