        <node type="node/const/perm/general" idtf="" shapeColor="0" id="72429872" parent="0" x="389.946" y="1235.82" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Классификация текста с использованием LSTM: модель принимает текстовые данные, преобразует слова в эмбеддинги (например, с помощью Word2Vec или GloVe), обрабатывает последовательность с использованием слоя LSTM и выполняет классификацию с помощью softmax-слоя.]]></content>
        </node>
