        <node type="node/const/perm/general" idtf="" shapeColor="0" id="72613728" parent="0" x="479.838" y="1419.47" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Text classification using LSTM: the model takes text data, converts words into embeddings (e.g., using Word2Vec or GloVe), processes the sequence with an LSTM layer, and classifies the output using a softmax layer.]]></content>
        </node>
