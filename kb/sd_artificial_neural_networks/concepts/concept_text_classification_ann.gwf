        <node type="node/const/perm/general" idtf="" shapeColor="0" id="72347104" parent="0" x="1161.01" y="330.73" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[GPT может использоваться для классификации текста, если текст обрабатывается как последовательность токенов, каждый из которых преобразуется в эмбеддинг, а итоговое предсказание делается на основе итогового скрытого состояния модели.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="72340064" parent="0" x="756.311" y="333.299" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[GPT can be used for text classification by treating the text as a sequence of tokens, converting each token into an embedding, and making the final prediction based on the model's final hidden state.]]></content>
        </node>
