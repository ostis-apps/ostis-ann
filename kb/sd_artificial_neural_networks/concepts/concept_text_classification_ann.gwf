        <node type="node/const/perm/general" idtf="Опр. (модель нейронной сети для классификации текста)" shapeColor="0" id="72321328" parent="0" left="0" top="0" right="430" bottom="28" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="917.202" y="858.855" haveBus="false" idtf_pos="0">
